{
  "name": "paseo-god-mode-plugin",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"server/**/*.test.ts\" \"shared/**/*.test.ts\" \"server/core/*.test.mjs\"",
    "check": "npm run typecheck && npm test",
    "preversion": "npm run check",
    "version": "node scripts/sync-version.mjs && git add shared/version.ts server/core/version.mjs"
  },
  "dependencies": {
    "@getpaseo/client": "0.11.4",
    "@getpaseo/protocol": "0.11.4"
  },
  "devDependencies": {
    "@getpaseo/plugin": "^0.11.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^26.0.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
